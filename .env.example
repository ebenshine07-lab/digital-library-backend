# ==============================================================================
# DIGITAL LIBRARY MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure your production / local environment secrets.
# ==============================================================================

# Server Configuration
PORT=8080

# PostgreSQL Database (Supabase PostgreSQL Connection URI)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_database_password

# JWT Security Secret (256-bit Hex Key for HMAC-SHA256 Signing)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Supabase Storage & API Keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# Supabase Storage Buckets
SUPABASE_BUCKET_PDFS=library-pdfs
SUPABASE_BUCKET_COVERS=book-covers

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

